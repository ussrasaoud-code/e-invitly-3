# ── Supabase (Project Settings → API) ─────────────────────────────
# URL et clé publique : peuvent être exposées au navigateur (protégées par RLS)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Clé secrète : UNIQUEMENT côté serveur. Ne jamais la committer ni la préfixer par NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Site ─────────────────────────────────────────────────────────
# URL publique du site (préproduction : https://e-invitly.netlify.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── E-mails transactionnels (Resend) — facultatif ─────────────────
# Sans clé, les demandes sont enregistrées mais aucun e-mail n'est envoyé.
RESEND_API_KEY=
EMAIL_FROM="E-Invitly <bonjour@e-invitly.com>"
# Adresse qui reçoit les alertes « nouvelle demande »
ADMIN_NOTIFICATION_EMAIL=

# ── Sécurité ─────────────────────────────────────────────────────
# Chaîne aléatoire longue (ex. : openssl rand -hex 32) — sert à hacher les IP pour l'anti-spam
IP_HASH_SALT=change-me
